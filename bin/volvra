#!/usr/bin/env bash
# =====================================================================
# volvra -- undo for Postgres
#
# A thin, dependency-free wrapper over psql.  The engine is the SQL; this
# exists so that reverting a mistake is one command with one confirmation,
# rather than nine function calls and a guessed timestamp.
#
# Connection comes from the standard PG* environment variables, or --dsn.
# =====================================================================
set -uo pipefail

PROG="${0##*/}"
DSN=""
ASSUME_YES=0

# ---------------------------------------------------------------- helpers

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

psql_run() {   # formatted, for humans
  psql ${DSN:+"$DSN"} -v ON_ERROR_STOP=1 --pset=border=2 --pset=null='∅' "$@"
}

psql_raw() {   # unaligned + tuples-only, for scripting
  psql ${DSN:+"$DSN"} -v ON_ERROR_STOP=1 -tA "$@"
}

# Quote a shell string as a SQL literal.
lit() { printf "'%s'" "${1//\'/\'\'}"; }

confirm() {
  local prompt="$1"
  [[ $ASSUME_YES -eq 1 ]] && return 0
  if [[ ! -t 0 ]]; then
    die "refusing to apply without a terminal to confirm on (pass --yes deliberately)"
  fi
  printf '%s [y/N] ' "$prompt" >&2
  local reply; read -r reply
  [[ "$reply" == "y" || "$reply" == "Y" ]]
}

usage() {
  cat <<'USAGE'
volvra -- undo for Postgres

  volvra status                       what is covered, and is it still capturing
  volvra uncovered [SCHEMA]           tables with no undo (default: public)
  volvra cover TABLE | --schema S     start covering changes
  volvra uncover TABLE | --schema S   stop covering (history is kept)

  volvra mark NAME [--note TEXT]      name a moment you may want back
  volvra marks                        marks, and what undoing to each costs
  volvra unmark NAME                  remove a mark (never the history)

  volvra log [-n N] [--since WHEN]    recent transactions, newest first
  volvra history TABLE PK_JSON        every version of one row

  volvra preview SELECTOR...          show the compensating SQL, change nothing
  volvra undo SELECTOR...             show it, ask once, then apply

  volvra preflight                    is this install production-shaped?
  volvra maintain                     partitions + retention + seal, in one call
  volvra seal                         make the history so far provable
  volvra verify                       re-check every seal against the history
  volvra forget TABLE PK_JSON         erase one subject's history (asks first)

SELECTOR (combine freely; at least one is required)
  --table TABLE          limit to a table          --txid N        one transaction
  --since WHEN           changes after WHEN        --until WHEN    changes up to WHEN
  --actor NAME           app-declared actor        --user NAME     database role
  --where SQL            predicate over old_row / new_row / pk
  --to NAME              everything since the mark NAME

OPTIONS
  --dsn DSN              libpq connection string (else PG* env vars)
  --yes                  skip the confirmation prompt
  --max-rows N           raise the blast-radius cap for this call
  --skip-conflicts       revert what still matches; leave changed rows alone
  -h, --help

EXAMPLES
  volvra log -n 5
  volvra verify
  volvra preflight
  volvra forget people '{"id":1}' --reason 'GDPR art.17'

SCHEDULING
  volvra maintain      # run this hourly or daily; it is the only scheduled job
  volvra mark before-deploy --note 'release 042'
  volvra undo --to before-deploy                 # put it back how it was
  volvra undo --txid 848291                      # undo that migration
  volvra undo --table orders --since '10 min ago'
  volvra preview --actor svc:pricing --since today
  volvra undo --table orders --since '1 hour ago' \
              --where "old_row->>'customer' = 'acme'"
USAGE
}

# ------------------------------------------------------- selector parsing

SEL_TABLE=""; SEL_TXID=""; SEL_SINCE=""; SEL_UNTIL=""
SEL_ACTOR=""; SEL_USER=""; SEL_WHERE=""; SEL_MARK=""
MAX_ROWS=""; SKIP_CONFLICTS="false"

parse_selector() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --table)          SEL_TABLE="${2:?--table needs a value}"; shift 2 ;;
      --txid)           SEL_TXID="${2:?--txid needs a value}"; shift 2 ;;
      --since)          SEL_SINCE="${2:?--since needs a value}"; shift 2 ;;
      --until)          SEL_UNTIL="${2:?--until needs a value}"; shift 2 ;;
      --actor)          SEL_ACTOR="${2:?--actor needs a value}"; shift 2 ;;
      --user)           SEL_USER="${2:?--user needs a value}"; shift 2 ;;
      --where)          SEL_WHERE="${2:?--where needs a value}"; shift 2 ;;
      --to)             SEL_MARK="${2:?--to needs a value}"; shift 2 ;;
      --max-rows)       MAX_ROWS="${2:?--max-rows needs a value}"; shift 2 ;;
      --skip-conflicts) SKIP_CONFLICTS="true"; shift ;;
      *) die "unknown selector option: $1" ;;
    esac
  done

  if [[ -z "$SEL_TABLE$SEL_TXID$SEL_SINCE$SEL_UNTIL$SEL_ACTOR$SEL_USER$SEL_WHERE$SEL_MARK" ]]; then
    die "a selector is required -- name a table, a txid, a time, an actor or a predicate"
  fi
}

# Build the named-argument list for volvra.preview_undo / volvra.undo.
# Relative times like '10 min ago' are resolved by Postgres, not by date(1),
# so the clock that matters is the server's.
selector_args() {
  local -a a=()
  [[ -n "$SEL_TABLE" ]] && a+=("target => $(lit "$SEL_TABLE")::regclass")
  [[ -n "$SEL_TXID"  ]] && a+=("txid => ${SEL_TXID}::bigint")
  # --to NAME resolves to the mark's moment, so it composes with the rest.
  [[ -n "$SEL_MARK" ]] && a+=("from_ts => (SELECT at FROM volvra.restore_point
                                           WHERE name = $(lit "$SEL_MARK"))")
  [[ -n "$SEL_SINCE" ]] && a+=("from_ts => $(lit "$SEL_SINCE")::timestamptz")
  [[ -n "$SEL_UNTIL" ]] && a+=("to_ts => $(lit "$SEL_UNTIL")::timestamptz")
  [[ -n "$SEL_ACTOR" ]] && a+=("actor => $(lit "$SEL_ACTOR")")
  [[ -n "$SEL_USER"  ]] && a+=("db_user => $(lit "$SEL_USER")")
  [[ -n "$SEL_WHERE" ]] && a+=("predicate => $(lit "$SEL_WHERE")")
  local IFS=', '; printf '%s' "${a[*]}"
}

# ------------------------------------------------------------- subcommands

cmd_status() {
  psql_run -c "SELECT table_name AS \"table\",
                      covered,
                      truncate_covered AS \"truncate covered\",
                      changes,
                      newest_change AS \"last change\"
               FROM volvra.status()"
  # health() is the interpretation; status() is the raw picture.
  local problems
  problems=$(psql_raw -c "SELECT count(*) FROM volvra.health()")
  if [[ "${problems:-0}" -gt 0 ]]; then
    printf '\n'
    psql_run -c "SELECT severity, problem, detail FROM volvra.health()"
  else
    printf '\nNo problems reported.\n'
  fi
}

cmd_uncovered() {
  local schema="${1:-public}"
  psql_run -c "SELECT table_name AS \"table\", reason
               FROM volvra.uncovered($(lit "$schema"))"
}

cmd_cover() {
  [[ $# -ge 1 ]] || die "cover needs a table, or --schema SCHEMA"
  if [[ "$1" == "--schema" ]]; then
    psql_run -c "SELECT table_name AS \"table\", status, detail
                 FROM volvra.enable_all($(lit "${2:?--schema needs a value}"))"
  else
    psql_run -c "SELECT volvra.enable($(lit "$1")::regclass) AS result"
  fi
}

cmd_uncover() {
  [[ $# -ge 1 ]] || die "uncover needs a table, or --schema SCHEMA"
  if [[ "$1" == "--schema" ]]; then
    psql_run -c "SELECT table_name AS \"table\", status
                 FROM volvra.disable_all($(lit "${2:?--schema needs a value}"))"
  else
    psql_run -c "SELECT volvra.disable($(lit "$1")::regclass) AS result"
  fi
}

cmd_preflight() {
  psql_run -c "SELECT severity, finding, detail FROM volvra.preflight()"
  local crit
  crit=$(psql_raw -c "SELECT count(*) FROM volvra.preflight() WHERE severity='critical'")
  if [[ "${crit:-0}" -gt 0 ]]; then
    printf '\n! %s critical finding(s). Do not run this install in production yet.\n' \
      "$crit" >&2
    return 2
  fi
  printf '\nNothing critical. Warnings above are worth reading anyway.\n'
}

cmd_maintain() {
  psql_run -c "SELECT step, detail, affected FROM volvra.maintain()"
}

cmd_seal() {
  psql_run -c "SELECT seal_id, from_id, to_id, row_count AS changes,
                      left(chain_hash, 16) || '…' AS chain
               FROM volvra.seal()"
  local n
  n=$(psql_raw -c "SELECT count(*) FROM volvra.change_log
                    WHERE id > coalesce((SELECT max(to_id) FROM volvra.seal), 0)")
  [[ "${n:-0}" -eq 0 ]] && printf '\nAll history is sealed.\n' \
                        || printf '\n%s change(s) still unsealed.\n' "$n"
}

cmd_verify() {
  psql_run -c "SELECT seal_id, from_id, to_id, rows_sealed, rows_found,
                      verdict, detail
               FROM volvra.verify()"
  local bad
  bad=$(psql_raw -c "SELECT count(*) FROM volvra.verify()
                      WHERE verdict IN ('TAMPERED','CHAIN BROKEN','SEAL FORGED')")
  if [[ "${bad:-0}" -gt 0 ]]; then
    printf '\n! %s sealed span(s) do not match the history and nothing lawful\n' "$bad" >&2
    printf '  explains it. Treat this as an integrity incident.\n' >&2
    return 2
  fi
  printf '\nEvery seal matches the history.\n'
}

cmd_forget() {
  local tbl="" pk="" hard="false" reason=""
  [[ $# -ge 2 ]] || die "forget needs a table and a pk as JSON"
  tbl="$1"; pk="$2"; shift 2
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --hard)   hard="true"; shift ;;
      --reason) reason="${2:?--reason needs a value}"; shift 2 ;;
      *) die "unknown option for forget: $1" ;;
    esac
  done

  local sel="$(lit "$tbl")::regclass, $(lit "$pk")::jsonb"
  psql_run -c "SELECT count(*) AS history_rows, min(ts) AS first_seen,
                      max(ts) AS last_seen
               FROM volvra.change_log
               WHERE table_name = volvra._fqname($(lit "$tbl")::regclass)
                 AND pk @> $(lit "$pk")::jsonb"

  if [[ "$hard" == "true" ]]; then
    printf '\nHard erasure DELETES these history rows outright.\n'
  else
    printf '\nRedaction blanks the row images and keeps the fact that a change\n'
    printf 'happened. Use --hard when the primary key is itself personal data.\n'
  fi
  printf 'This cannot be undone.\n'

  confirm "Erase this subject's history?" || { printf 'Nothing was changed.\n'; return 1; }

  # NULL, not an empty string: the ledger must distinguish "no reason given"
  # from "reason given as empty".
  local reason_sql="NULL"
  [[ -n "$reason" ]] && reason_sql="$(lit "$reason")"
  psql_run -c "SELECT mode, rows_erased, from_id, to_id
               FROM volvra.forget($sel, hard => $hard,
                                  reason => $reason_sql)"
}

cmd_mark() {
  [[ $# -ge 1 ]] || die "mark needs a name"
  local name="$1" note="" ; shift
  local replace=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --note)    note="${2:?--note needs a value}"; shift 2 ;;
      --replace) replace=true; shift ;;
      *) die "unknown option for mark: $1" ;;
    esac
  done
  local note_sql="NULL"
  [[ -n "$note" ]] && note_sql="$(lit "$note")"
  psql_run -c "SELECT volvra.mark($(lit "$name"), $note_sql,
                                  p_replace => $replace) AS marked_at"
}

cmd_marks() {
  psql_run -c "SELECT name, at, age, created_by,
                      changes_since AS \"changes since\",
                      tables_since  AS \"tables\", note
               FROM volvra.marks()"
}

cmd_unmark() {
  [[ $# -ge 1 ]] || die "unmark needs a name"
  psql_run -c "SELECT volvra.unmark($(lit "$1")) AS removed"
}

cmd_log() {
  local n=20 since=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n)      n="${2:?-n needs a value}"; shift 2 ;;
      --since) since="${2:?--since needs a value}"; shift 2 ;;
      *) die "unknown option for log: $1" ;;
    esac
  done
  local from="NULL"
  [[ -n "$since" ]] && from="$(lit "$since")::timestamptz"
  psql_run -c "SELECT txid,
                      ended AS \"when\",
                      array_to_string(db_users, ',') AS \"by\",
                      array_to_string(tables, ', ')  AS \"tables\",
                      inserts AS ins, updates AS upd, deletes AS del,
                      changes
               FROM volvra.transactions($from, NULL, $n)"
}

cmd_history() {
  [[ $# -eq 2 ]] || die "history needs a table and a pk as JSON, e.g. history orders '{\"id\":1}'"
  psql_run -c "SELECT change_id, ts AS \"when\", op, actor, db_user AS \"role\",
                      old_row, new_row
               FROM volvra.history($(lit "$1")::regclass, $(lit "$2")::jsonb)"
}

show_plan() {   # prints the plan, returns the row count on stdout via PLAN_ROWS
  local args="$1"
  psql_run -c "SELECT seq, table_name AS \"table\", op, inverse_op AS inverse,
                      pk, conflict, left(stmt, 70) || '…' AS \"compensating sql\"
               FROM volvra.preview_undo($args)" || return 1
  PLAN_ROWS=$(psql_raw -c "SELECT count(*) FROM volvra.preview_undo($args)")
  PLAN_CONFLICTS=$(psql_raw -c \
    "SELECT count(*) FROM volvra.preview_undo($args) WHERE conflict")
}

cmd_preview() {
  parse_selector "$@"
  show_plan "$(selector_args)"
}

cmd_undo() {
  parse_selector "$@"
  local sel; sel="$(selector_args)"

  PLAN_ROWS=0; PLAN_CONFLICTS=0
  show_plan "$sel" || die "could not build a plan"

  if [[ "${PLAN_ROWS:-0}" -eq 0 ]]; then
    printf '\nNothing to undo for that selection.\n'
    return 0
  fi

  printf '\n%s change(s) will be reverted' "$PLAN_ROWS"
  if [[ "${PLAN_CONFLICTS:-0}" -gt 0 ]]; then
    printf ', and %s row(s) have changed since they were captured' "$PLAN_CONFLICTS"
    if [[ "$SKIP_CONFLICTS" == "true" ]]; then
      printf ' -- those will be left alone'
    else
      printf '.\nUndo will refuse rather than overwrite them; pass --skip-conflicts to\nrevert the rest and leave those alone'
    fi
  fi
  printf '.\n'

  confirm "Apply this undo?" || { printf 'Nothing was changed.\n'; return 1; }

  local extra="confirm => true, skip_conflicts => ${SKIP_CONFLICTS}"
  [[ -n "$MAX_ROWS" ]] && extra="$extra, max_rows => ${MAX_ROWS}::integer"

  psql_run -c "SELECT seq, table_name AS \"table\", inverse_op AS applied, pk, status
               FROM volvra.undo($sel, $extra)"
}

# ------------------------------------------------------------------- main

[[ $# -eq 0 ]] && { usage; exit 0; }

# global options may appear before the subcommand
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dsn)      DSN="${2:?--dsn needs a value}"; shift 2 ;;
    --yes|-y)   ASSUME_YES=1; shift ;;
    -h|--help)  usage; exit 0 ;;
    *) break ;;
  esac
done

[[ $# -eq 0 ]] && { usage; exit 0; }
CMD="$1"; shift

# ...and after it, so `volvra undo --txid 1 --yes` works too
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dsn)     DSN="${2:?--dsn needs a value}"; shift 2 ;;
    --yes|-y)  ASSUME_YES=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

command -v psql >/dev/null || die "psql not found on PATH"

case "$CMD" in
  status)      cmd_status      "${ARGS[@]+"${ARGS[@]}"}" ;;
  uncovered)   cmd_uncovered   "${ARGS[@]+"${ARGS[@]}"}" ;;
  cover)       cmd_cover       "${ARGS[@]+"${ARGS[@]}"}" ;;
  uncover)     cmd_uncover     "${ARGS[@]+"${ARGS[@]}"}" ;;
  log)         cmd_log         "${ARGS[@]+"${ARGS[@]}"}" ;;
  mark)        cmd_mark        "${ARGS[@]+"${ARGS[@]}"}" ;;
  marks)       cmd_marks       "${ARGS[@]+"${ARGS[@]}"}" ;;
  unmark)      cmd_unmark      "${ARGS[@]+"${ARGS[@]}"}" ;;
  preflight)   cmd_preflight   "${ARGS[@]+"${ARGS[@]}"}" ;;
  maintain)    cmd_maintain    "${ARGS[@]+"${ARGS[@]}"}" ;;
  seal)        cmd_seal        "${ARGS[@]+"${ARGS[@]}"}" ;;
  verify)      cmd_verify      "${ARGS[@]+"${ARGS[@]}"}" ;;
  forget)      cmd_forget      "${ARGS[@]+"${ARGS[@]}"}" ;;
  history)     cmd_history     "${ARGS[@]+"${ARGS[@]}"}" ;;
  preview)     cmd_preview     "${ARGS[@]+"${ARGS[@]}"}" ;;
  undo)        cmd_undo        "${ARGS[@]+"${ARGS[@]}"}" ;;
  help)        usage ;;
  *)           die "unknown command '$CMD' (try: $PROG --help)" ;;
esac
