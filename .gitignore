# =====================================================================
# What must never be committed.
#
# Two rules of thumb: anything a build regenerates, and anything that
# carries a credential. A stale generated file is worse than a missing
# one, because it still works -- it just works from the wrong source.
# =====================================================================

# ---------------------------------------------------------------------
# Compiled binaries from the two Go modules
#
# Patterns, not exact names: `make -C cli linux` writes cli/volvra-linux,
# and the exact-name rules these replace covered cli/volvra but not that
# -- so the one binary the documentation tells people to build was the
# one binary git would have happily committed.
# ---------------------------------------------------------------------
cli/volvra
cli/volvra-*
companion/volvra-companion
companion/volvra-companion-*

# Go source and docs are never build output, whatever the name suffix
# rules above might otherwise catch.
!*.go
!*.md

# Go test, coverage, and profiling output
*.test
cli/*.out
cli/*.prof
companion/*.out
companion/*.prof
__debug_bin*

# ---------------------------------------------------------------------
# Regenerated by a build or a test run
# ---------------------------------------------------------------------

# Test output, including the CLI binaries test/run.sh cross-builds
test/logs/

# MkDocs build output, regenerated by `mkdocs build`
site/

# Python environment for building the documentation
.venv/
venv/

# Extension script, regenerated by extension/build.sh from sql/volvra.sql.
# Deliberately not committed: a stale copy still installs, and having one
# in the tree invites editing it instead of the source.
extension/volvra--*.sql

# ---------------------------------------------------------------------
# Credentials
#
# The CLI and the companion both take a DSN, so a connection string is
# the thing most likely to be left in a file next to them.
# ---------------------------------------------------------------------
.env
.env.*
*.pgpass
.pgpass
*.pem
*.key
!docs/**/*.key

# ---------------------------------------------------------------------
# macOS, editor, and IDE noise
# ---------------------------------------------------------------------
.DS_Store
._*
*~
*.swp
*.orig
*.bak
*.rej
.idea/
.vscode/
*.iml

# Release artifacts from `make release` in cli/ and companion/
cli/dist/
companion/dist/
